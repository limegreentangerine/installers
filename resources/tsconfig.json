{
	"compilerOptions": {
		"target": "es2019",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["es2019", "dom", "dom.iterable"],
		"verbatimModuleSyntax": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"paths": {
			"$libs": ["./public/ts/libs/index.ts"],
			"$types": ["./public/ts/types/index.ts"]
		}
	},
	"include": [
		"public/**/*.ts",
		"svelte.d.ts"
	]
}
