{
    "name": "limegreentangerine/installers",
    "description": "Installer package for configuring new concrete CMS sites",
    "type": "composer-plugin",
    "minimum-stability": "dev",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Limegreentangerine\\Installers\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Lee Jones",
            "email": "prolific.jones82@gmail.com"
        }
    ],
    "require": {
        "composer-plugin-api": "^2.0",
        "limegreentangerine/class_kit": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "php -d error_reporting='E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED' vendor/bin/phpunit",
		"test-coverage": "php -d error_reporting='E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED' vendor/bin/phpunit --coverage-text",
        "format": "php-cs-fixer fix",
		"format:check": "php-cs-fixer check --diff"
    },
	"bin": [
		"bin/install-classkit-resources",
		"bin/install-toolkit-resources",
		"bin/uninstall-classkit-resources"
	],
    "extra": {
        "class": "Limegreentangerine\\Installers\\Plugin"
    }
}
