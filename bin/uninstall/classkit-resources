#!/usr/bin/env php
<?php

declare(strict_types=1);

echo "Uninstalling ClassKit resources..." . PHP_EOL;

$projectRoot = getcwd();

// install required npm packages
$commands = [
    [
        'npm',
        'uninstall',
        '--save-dev',
        'typescript',
        'ts-loader',
        '@types/node',
        'svelte',
        'svelte-loader',
    ]
];

echo "Uninstalling npm packages..." . PHP_EOL;

foreach ($commands as $command) {
    $process = proc_open(
        $command,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $projectRoot
    );

    if (!is_resource($process)) {
        throw new RuntimeException('Unable to start npm.');
    }

    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        exit($exitCode);
    }
}

$filesToRemove = [
    './tsconfig.json',
    './svelte.config.js',
    './svelte.d.ts'
];

foreach ($filesToRemove as $ftr) {
    if (file_exists($ftr)) {
        if (!unlink($ftr)) {
            fwrite(STDERR, "Unable to remove: {$ftr}\n");
        }
    }
}

$tsDestinationFolder = './public/ts';
$tsIterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($tsDestinationFolder, FilesystemIterator::SKIP_DOTS),
    RecursiveIteratorIterator::SELF_FIRST
);

foreach ($tsIterator as $item) {
    if (file_exists($item->getPathname())) {
        if (!unlink($item->getPathname())) {
            fwrite(STDERR, "Unable to remove: {$item->getPathname()}\n");
        }
    }
}

echo "ClassKit resources uninstalled" . PHP_EOL;
