#!/usr/bin/env php
<?php

declare(strict_types=1);

echo "Installing ClassKit resources..." . PHP_EOL;

$projectRoot = getcwd();

// install required npm packages
$commands = [
    [
        'npm',
        'install',
        '--save-dev',
        'typescript',
        'ts-loader',
        '@types/node',
        'svelte',
        'svelte-loader',
    ],
    [
        'npm',
        'install',
        '--save',
        'bootstrap',
        'bootstrap-icons',
        '@popperjs/core',
        '@types/bootstrap',
    ]
];

echo "Installing npm packages..." . PHP_EOL;

foreach ($commands as $command) {
    $process = proc_open(
        $command,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $projectRoot
    );

    if (!is_resource($process)) {
        throw new RuntimeException('Unable to start npm.');
    }

    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        exit($exitCode);
    }
}

$resourcesFolder = '.' . DIRECTORY_SEPARATOR . 'public/packages/class_kit/resources';


$componentConfig = $resourcesFolder . DIRECTORY_SEPARATOR . 'svelte-components.json';
if (file_exists($componentConfig) && !file_exists('./svelte-components.json')) {
    if (!copy($componentConfig, './svelte-components.json')) {
        fwrite(STDERR, "Unable to copy: {$componentConfig}\n");
    }
} else {
    echo "./svelte-components.json exists -- (ignored)\n";
}

$tsConfig = $resourcesFolder . DIRECTORY_SEPARATOR . 'tsconfig.json';
if (file_exists($tsConfig) && !file_exists('./tsconfig.json')) {
    if (!copy($tsConfig, './tsconfig.json')) {
        fwrite(STDERR, "Unable to copy: {$tsConfig}\n");
    }
} else {
    echo "{$tsConfig} exists -- (ignored)\n";
}

$svelteConfig = $resourcesFolder . DIRECTORY_SEPARATOR . 'svelte.config.js';
if (file_exists($svelteConfig) && !file_exists('./svelte.config.js')) {
    if (!copy($svelteConfig, './svelte.config.js')) {
        fwrite(STDERR, "Unable to copy: {$svelteConfig}\n");
    }
} else {
    echo "{$svelteConfig} exists -- (ignored)\n";
}

$svelteTypeDef = $resourcesFolder . DIRECTORY_SEPARATOR . 'svelte.d.ts';
if (file_exists($svelteTypeDef) && !file_exists('./svelte.d.ts')) {
    if (!copy($svelteTypeDef, './svelte.d.ts')) {
        fwrite(STDERR, "Unable to copy: {$svelteTypeDef}\n");
    }
} else {
    echo "{$svelteTypeDef} exists -- (ignored)\n";
}

$tsDestinationFolder = './public/ts';
if (!is_dir($tsDestinationFolder) && !mkdir($tsDestinationFolder, 0755, true)) {
    fwrite(STDERR, "Unable to create: {$tsDestinationFolder}\n");
} else {
    $tsFolder = $resourcesFolder . DIRECTORY_SEPARATOR . 'ts';
    $tsIterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($tsFolder, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );

    foreach ($tsIterator as $item) {
        $relativePath = substr($item->getPathname(), strlen($tsFolder) + 1);
        $destination = $tsDestinationFolder . '/' . $relativePath;

        if ($item->isDir()) {
            if (!is_dir($destination) && !mkdir($destination, 0755, true)) {
                fwrite(STDERR, "Unable to create: {$relativePath}\n");
                exit(1);
            }
        } elseif (file_exists($destination)) {
            echo "{$relativePath} exists -- (ignored)\n";
            continue;
        } elseif (!copy($item->getPathname(), $destination)) {
            fwrite(STDERR, "Unable to copy: {$relativePath}\n");
            exit(1);
        }
    }
}

echo "ClassKit resources installed" . PHP_EOL;
